# Copy to `.env` in the project root and adjust. Never commit the real .env.

# --- Core -------------------------------------------------------------------
DJANGO_DEBUG=False
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated: the server's LAN IP and any hostname the lab PCs use
DJANGO_ALLOWED_HOSTS=192.168.1.10,cbt.local,localhost,127.0.0.1
# Required when posting forms to a non-localhost origin (include scheme)
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.10,http://cbt.local
DJANGO_TIME_ZONE=Asia/Kolkata
# Set True only if you terminate TLS in Nginx
USE_HTTPS=False

# --- Database (PostgreSQL) ---------------------------------------------------
# DB_ENGINE=sqlite is accepted ONLY when DJANGO_DEBUG=True (quick local dev)
DB_ENGINE=postgresql
DB_NAME=cbt_db
DB_USER=cbt_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
# psycopg connection pool per Gunicorn worker process (Django 5.1+)
DB_POOL=True
DB_POOL_MIN=2
DB_POOL_MAX=6

# --- Sessions ----------------------------------------------------------------
# Seconds a login stays valid (default 6 hours = a full school day)
SESSION_COOKIE_AGE=21600

# --- CBT behaviour -------------------------------------------------------------
CBT_SCHOOL_NAME=Springfield Public School
# Printed on login slips — what students type into the lab browser
CBT_SERVER_URL=http://192.168.1.10/
# BLOCK   = second login is refused until an admin unlocks the student
# REPLACE = second login wins, the old PC's session is destroyed and logged
CBT_SINGLE_SESSION_MODE=BLOCK
CBT_TIMER_GRACE_SECONDS=5
CBT_TIMER_SYNC_INTERVAL_SECONDS=30
CBT_HEARTBEAT_INTERVAL_SECONDS=15
CBT_MONITOR_REFRESH_SECONDS=10
CBT_GENERATED_PASSWORD_LENGTH=10
CBT_MAX_QUESTION_IMAGE_MB=2
# BLOCK mode: allow re-login from the same lab PC IP without admin unlock
CBT_ALLOW_SAME_IP_RELOGIN=True
CBT_MAX_UPLOAD_MB=5
# Exam screen anti-cheat
CBT_REQUIRE_FULLSCREEN=True
# Auto-submit after N tab-switch/fullscreen/blur violations (0 = log only)
CBT_MAX_VIOLATIONS=0
# PBKDF2 iterations for passwords (LAN-tuned so 75 logins at once stay fast)
CBT_PASSWORD_HASH_ITERATIONS=100000
# Trust the X-Real-IP header set by our own Nginx (only safe behind Nginx)
CBT_TRUST_X_REAL_IP=True
